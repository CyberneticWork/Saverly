# Environment Variables
DATABASE_URL="postgresql://postgres:password@localhost:5432/pricewise"
JWT_SECRET="change-this-to-a-long-random-secret-key-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Google Cloud Vision (optional - for better OCR accuracy)
GOOGLE_CLOUD_VISION_KEY=""
GOOGLE_CLOUD_PROJECT_ID=""

# Gemini OCR (optional - no custom endpoint required)
GEMINI_API_KEY="AIzaSyD5cJ15r22wO3m4k80M9RznHze3Fz2Gve0"
GEMINI_MODEL="gemini-2.0-flash-lite"
GEMINI_TIMEOUT_MS="30000"

# External OCR API (optional - takes priority if configured)
CROMP_OCR_API_URL=""
CROMP_OCR_API_KEY=""
CROMP_OCR_BEARER_TOKEN=""
CROMP_OCR_TIMEOUT_MS="30000"
CROMP_OCR_IMAGE_FIELD="imageBase64"
CROMP_OCR_TEXT_PATH=""

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=""

# Admin default credentials (used during seeding)
ADMIN_EMAIL="admin@pricewise.com"
ADMIN_PASSWORD="Admin@123"
